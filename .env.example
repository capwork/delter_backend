# Copy to .env. Every value is optional; these are the defaults.
DELTER_DATA_DIR=./delter-data
DELTER_LOG_LEVEL=INFO
DELTER_EVENT_BUS=redis
DELTER_REDIS_URL=redis://localhost:6379/0
DELTER_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
# parallel stage jobs per service instance
DELTER_WORKER_CONCURRENCY=1
# Chrome location if Selenium cannot find it
# DELTER_CHROME_BINARY=C:/Program Files/Google/Chrome/Application/chrome.exe
